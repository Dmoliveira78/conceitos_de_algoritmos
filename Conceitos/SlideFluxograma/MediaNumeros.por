programa
{
	/*
	Calcule a média de 3 valores digitados pelo usuário
	*/
	funcao inicio()
	{
		real n1, n2, n3, media
		
		escreva("Digite o 1 numero: ")
		leia(n1)
		escreva("Digite o 2 numero: ")
		leia(n2)
		escreva("Digite o 3 numero: ")
		leia(n3)

		media = (n1 + n2 + n3) / 3

		escreva("A media dos 3 numero e: ", media)
	}
}
