programa
{
	/*
	Calcular o dobro de um número informado pelo
	usuário.
	*/
	funcao inicio()
	{
		inteiro numero, dobro

		escreva("Digite um numero: ")
		leia(numero)

		dobro = numero * 2
		
		escreva("Dobro e: ", dobro)	
	}
}
