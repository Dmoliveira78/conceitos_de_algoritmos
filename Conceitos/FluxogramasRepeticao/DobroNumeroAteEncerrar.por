programa
{
	
	funcao inicio()
	{
		inteiro num, dobro, opcao
		opcao = 0
		faca{
			escreva("Digite um numero para saber o dobro: ")
			leia(num)
			dobro = num * 2
			escreva("Dobro e: ",dobro)
			escreva("\nQuer saber o dobro de outro numero? 1- sim e 2- nao\n")
			leia(opcao)
			}enquanto(opcao == 1)
	}
}
