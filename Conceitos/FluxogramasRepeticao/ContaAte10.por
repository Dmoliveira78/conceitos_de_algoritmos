programa
{
	/*
	Elabore um algoritmo que mostre na tela os
	valores de zero a 10
	*/
	funcao inicio()
	{
		inteiro i
		i = 0
		faca{
			escreva(i)
			i++
			}enquanto(i <= 10)
	}
}
