programa
{
	
	funcao inicio()
	{
		inteiro numero

		escreva("Por favor, digite um número positivo: ")
		leia(numero)
		enquanto(numero < 0){
			escreva("Por favor, digite um número positivo: ")
			leia(numero)
			}
			escreva("Ok Tudo certo!")
	}
}
