programa
{
	
	funcao inicio()
	{
		/* INICIO DOS COMENTARIOS
		 	->  TODO PROGRAMA E FEITO DENTRO DA FUNCAO INICIO
		 	-> OPERADORES
				IGUAL = "=="
				MAIOR QUE = ">"
				MENOR QUE = "<"
				MAIOR OU IGUAL = ">="
				MENOR OU IGUAL = "<="
				DIFERENTE = "!="
		 		
			-> EXIBIR MENSAGEM NA TELA
				escreva("AQUI VAI A MENSAGEM QUE VAI APARECER NA TELA")
			
			-> TIPOS DE VARIAVEIS
				real: numeros quebrados por exemplo 5.23
				inteiro: numeros inteiros por exemplo 1, 2, 3, 4, 5
				caracter: letras por exemplo a, b, c
					letra = 'a'
				cadeia: frases com mais de 1 caracter
					cadeia frase
						frase = "Ola essa e a frase"

			-> LER E SALVAR VARIAVEL 
				exemplo: inteiro numero  
				leia(inteiro)

			-> EXIBIR MENSAGEM E A VARIAVEL NO TEXTO
				escreva("O numero e: ",numero)

			-> PULAR LINHA
				\n

			-> ATRIBUIR VALORES AS VARIAVEIS
				Exemplo
					inteiro numero
						numero = 5  define a variavel numero igual na linha anterior e essa 2 linha e definido o valor da variavel 

			-> CONDICIONAIS
				-> SE E SENAO
				
					se(condicao){
						aqui toda condicao
					}
					
					-> o senao e assim

					se(condicao){
					
					}senao{
						outra condicao
					}

				exemplo
					se(idade >= 18){
						escreva("Voce e maior de idade")
					}senao{
						escreva("Voce nao e maior de idade")
					}



			-> EXEMPLO UM PROGRAMA
				//INICIO DO PROGRAMA
					programa
					{
						funcao inicio()
