							inteiro numero
							real
	
							escreva("Digite o numero: ")
							leia(numero)   -> Aqui vai ler o numero que a pessoa digitou e salvar ele
	
							escreva("O Numero digitado e: ",numero)					
						}
					}
				// FIM DO PROGRAMA
		
		*/ //FIM DE TODOS OS COMENTARIOS
		
	}
}
