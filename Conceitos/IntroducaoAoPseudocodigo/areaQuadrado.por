programa
{
	/*
	 	Calcule a área de um terreno quadrado e mostre o
		resultado na tela.
	*/
	funcao inicio()
	{
		real lado, area

		escreva("Digite o tamanho do lado do quadrado: ")
		leia(lado)
		area = lado * lado
		escreva("A area do quadrado e: ",area)
	}
}
