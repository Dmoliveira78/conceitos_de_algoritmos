programa
{
	/*	
	  	Crie um algoritmo que calcule a média
		aritmética das notas de um aluno. Assuma
		que ele realizou 3 atividades avaliativas,
		todas com valor 10
	*/
	
	funcao inicio()
	{
		inteiro nota1, nota2, nota3
		real media
		nota1 = 10
		nota2 = 10
		nota3 = 10
		media = (nota1 + nota2 + nota3) / 3
		escreva("A Media e : ",media)
		
	}
}
