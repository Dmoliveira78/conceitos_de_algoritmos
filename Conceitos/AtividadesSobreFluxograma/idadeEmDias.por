programa
{
	/*
		Crie um fluxograma que solicite a idade de uma pessoa em anos. o algoritmo deve calcular e mostrar a idade aproximada
		dessa pessoa expressa em dias(considere que cada ano tem exatamente 365 dias.)
	*/
	funcao inicio()
	{
		inteiro idade, idadeEmDias

		escreva("Digite sua idade: ")
		leia(idade)

		idadeEmDias = idade * 365
		
		escreva("A idade aproximada em dias e: ",idadeEmDias)
	}
}
